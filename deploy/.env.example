# Copier ce fichier en /opt/leq/.env sur le serveur, puis remplir les valeurs.
# Ce fichier ne doit JAMAIS être envoyé sur GitHub ni collé dans une conversation.

# --- Mails automatiques (Google Workspace) ---------------------------------
# Compte qui envoie les mails
SMTP_USER=formationn@liebeneloquence.com
# « Mot de passe d'application » Google (16 caractères, sans espaces)
# À créer sur https://myaccount.google.com/apppasswords (validation en 2 étapes requise)
SMTP_PASSWORD=
# Destinataire des notifications (demandes, réservations, quiz)
MAIL_TO_ADMIN=formationn@liebeneloquence.com

# --- Statistiques Umami ----------------------------------------------------
# Deux longues valeurs aléatoires (générées par la commande du guide)
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# --- Newsletter Brevo (facultatif) -----------------------------------------
# Si renseignés, chaque inscrit à la newsletter est ajouté automatiquement à la liste Brevo.
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Tableau de bord Excel (LEQ-donnees.xlsx) -------------------------------
# Clé qui protège l'accès aux données des formulaires. Générée sur le serveur avec :
#   echo "DATA_API_KEY=$(openssl rand -hex 32)" >> /opt/leq/.env
DATA_API_KEY=
